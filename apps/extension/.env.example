# Copy this file to .env (ignored by git) to change how the extension is built locally. Every variable is optional.

# The /dev/null server the extension talks to, as an http(s) URL: its origin is kept (scheme, host and port).
# Left empty, unset, or not a valid URL: https://dev-null.sh. Set, the extension is named "/dev/null (dev)" and only
# gets access to that server, not to dev-null.sh.
WXT_DEVNULL_URL=
